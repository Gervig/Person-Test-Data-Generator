 ]
+
+# Static analysis -------------------------------------------------------------
+
+[tool.ruff]
+line-length = 100
+extend-exclude = [".venv"]
+
+[tool.ruff.lint]
+# E/W pycodestyle, F pyflakes, I import order, B bugbear, UP pyupgrade,
+# C90 complexity, S bandit-style security rules
+select = ["E", "F", "W", "I", "B", "UP", "C90", "S"]
+
+[tool.ruff.lint.per-file-ignores]
+"tests/**" = ["S101", "S311"]                # assert and seeded Random are fine in tests
+"app/models/phone_prefixes.py" = ["E501"]    # long data table
+
+[tool.bandit]
+exclude_dirs = [".venv", "tests"]
+
+[tool.mypy]
+files = ["app"]
+python_version = "3.12"
+plugins = ["pydantic.mypy"]
+warn_unused_ignores = true
+
+[[tool.mypy.overrides]]
+module = ["mariadb", "mariadb.*"]
+ignore_missing_imports = true
+
+# Coverage --------------------------------------------------------------------
+
+[tool.coverage.run]
